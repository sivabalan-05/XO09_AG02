# Optional: enables LangChain's grounded recruiter-summary node. Never expose this in the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional model override for requisition requirement suggestions.
OPENAI_REQUIREMENT_MODEL=
AGENT_PORT=8787
# Render supplies PORT automatically in production. Locally, AGENT_PORT is used.

# LinkedIn OpenID Connect. Create an app at https://www.linkedin.com/developers/
# and add the exact HTTPS callback URL below to its Auth settings.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-domain.example/api/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile email
APP_ORIGIN=http://127.0.0.1:5175
VITE_LINKEDIN_OAUTH_API_URL=http://127.0.0.1:8787
